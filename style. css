/* Reset & Base Typography */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background-color: #eef7fc; /* Soft icy-blue backdrop */
  color: #102a43;
  line-height: 1.6;
  padding: 20px 14px 40px;
}

/* Main Centered Container */
.container,
main,
header,
footer {
  max-width: 720px;
  margin-left: auto;
  margin-right: auto;
}

/* Header Banner */
header {
  background: linear-gradient(135deg, #0284c7, #0369a1);
  color: #ffffff;
  padding: 28px 22px;
  border-radius: 16px;
  text-align: center;
  box-shadow: 0 10px 24px rgba(2, 132, 199, 0.18);
  margin-bottom: 20px;
}

header h1 {
  font-size: 1.85rem;
  line-height: 1.25;
  margin-bottom: 8px;
  letter-spacing: -0.01em;
}

header p {
  font-size: 1rem;
  color: #e0f2fe;
}

/* Section Cards */
section {
  background-color: #ffffff;
  border: 1px solid #bae6fd;
  border-radius: 14px;
  padding: 20px;
  margin-bottom: 18px;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
}

section h2 {
  font-size: 1.25rem;
  color: #0369a1;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 2px solid #e0f2fe;
}

/* Contact Details & Links */
.contact-details p,
section > p {
  margin-bottom: 10px;
}

a {
  color: #0284c7;
  font-weight: 600;
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

/* Highlighted WhatsApp Button */
.whatsapp-button {
  margin-top: 14px;
}

.whatsapp-button a {
  display: inline-block;
  background-color: #16a34a;
  color: #ffffff;
  padding: 11px 18px;
  border-radius: 10px;
  font-weight: 700;
  text-decoration: none;
  box-shadow: 0 4px 12px rgba(22, 163, 74, 0.25);
  transition: transform 0.15s ease, background-color 0.15s ease;
}

.whatsapp-button a:hover {
  background-color: #15803d;
  transform: translateY(-1px);
  text-decoration: none;
}

/* Products List Styled as Clean Tiles */
ul {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
  gap: 10px;
  margin-top: 8px;
}

ul li {
  background-color: #f0f9ff;
  border: 1px solid #bae6fd;
  border-radius: 10px;
  padding: 10px 12px;
  font-weight: 600;
  color: #0c4a6e;
}

/* Footer */
footer {
  text-align: center;
  font-size: 0.9rem;
  color: #486581;
  margin-top: 24px;
}
